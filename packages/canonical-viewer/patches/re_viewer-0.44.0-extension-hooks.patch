+    > = std::sync::OnceLock::new();
+
+    /// Runs on every new [`crate::App`] once it is constructed.
+    pub static SETUP_APP: std::sync::OnceLock<fn(&mut crate::App)> = std::sync::OnceLock::new();
+}
