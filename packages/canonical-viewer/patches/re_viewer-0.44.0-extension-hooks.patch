+/// Hooks for a viewer that links `re_viewer` and adds renderers, visualizers or device needs.
+///
+/// Set them once, before the viewer starts: in `main` on native, in `#[wasm_bindgen(start)]` on the web.
+/// They apply to the native, headless and web viewers alike.
+pub mod extension_hooks {
+    /// Adjusts the device every viewer (native, headless, web) requests, given the adapter and Rerun's descriptor.
+    pub static DEVICE_DESCRIPTOR: std::sync::OnceLock<
+        fn(&wgpu::Adapter, wgpu::DeviceDescriptor<'static>) -> wgpu::DeviceDescriptor<'static>,
+    > = std::sync::OnceLock::new();
+
+    /// Runs on every new [`crate::App`] once it is constructed.
+    pub static SETUP_APP: std::sync::OnceLock<fn(&mut crate::App)> = std::sync::OnceLock::new();
+}
