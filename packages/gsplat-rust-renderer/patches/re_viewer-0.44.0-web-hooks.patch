+/// Hooks for a custom web viewer that links `re_viewer` and adds renderers or visualizers.
+/// Set them before JavaScript constructs `WebHandle` (e.g. in `#[wasm_bindgen(start)]`).
+#[cfg(target_arch = "wasm32")]
+pub mod web_hooks {
+    /// Adjusts the wgpu configuration that `WebHandle::start` passes to eframe.
+    pub static WGPU_OPTIONS: std::sync::OnceLock<fn(&mut egui_wgpu::WgpuConfiguration)> =
+        std::sync::OnceLock::new();
+
+    /// Runs on the new `App` right after `App::new` in the web entry point.
+    pub static SETUP_APP: std::sync::OnceLock<fn(&mut crate::App)> = std::sync::OnceLock::new();
+}
