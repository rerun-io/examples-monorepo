watch_file ../../pixi.lock
# `slam-rs-dev` composes two linux-only catalog features, so on a Mac the lane
# is the osx one; a wrong default here fails direnv in the package directory.
if [ "$(uname)" = "Darwin" ]; then
    PIXI_ENV="${PIXI_ENV:-slam-rs-osx-dev}"
else
    PIXI_ENV="${PIXI_ENV:-slam-rs-dev}"
fi
source_env_if_exists .envrc.local
eval "$(pixi shell-hook -e "$PIXI_ENV" --manifest-path ../.. --frozen)"
