# Patch: asmk.hamming from asmk_rs (Rust) instead of the Cython extension
#
# Upstream builds asmk.hamming from cython/hamming.pyx through setup.py's ext_modules.
# packages/asmk-rs ports it to Rust with the same API (bit-exact), so:
#
# 1. setup.py is deleted: with the extension gone it only duplicated pyproject.toml
#    (add-pyproject-toml.patch), and the package becomes pure Python.
# 2. asmk/hamming.py re-exports asmk_rs, so `from . import hamming` in kernel.py and
#    upstream's test/test_hamming.py keep working unchanged.
diff --git a/asmk/hamming.py b/asmk/hamming.py
new file mode 100644
index 0000000..7dc7d3c
--- /dev/null
+++ b/asmk/hamming.py
@@ -0,0 +1,3 @@
+"""asmk's Cython module `hamming` (cython/hamming.pyx) in Rust: packages/asmk-rs (`asmk_rs`) in the workspace."""
+
+from asmk_rs import binarize_and_pack, binarize_and_pack_2D, hamming_cdist_packed, hamming_dist_packed  # noqa: F401
diff --git a/setup.py b/setup.py
deleted file mode 100644
index d814df2..0000000
--- a/setup.py
+++ /dev/null
@@ -1,35 +0,0 @@
-import sys
-from setuptools import setup, Extension
-from setuptools.command.install import install
-
-class InstallWrapper(install):
-
-    def run(self):
-        try:
-            import faiss
-        except ImportError:
-            sys.stderr.write("\nERROR: faiss package not installed (install either faiss-cpu or " \
-                             "faiss-gpu before installing this package.).\n\n")
-            sys.exit(1)
-
-        install.run(self)
-
-
-setup(
-    name="asmk",
-    version="0.1",
-    description="ASMK Python implementation for ECCV'20 paper \"Learning and aggregating deep " \
-                "local descriptors for instance-level recognition\"",
-    author="Tomas Jenicek, Giorgos Tolias",
-    packages=[
-        "asmk",
-    ],
-    ext_modules=[Extension("asmk.hamming", ["cython/hamming.c"])],
-    install_requires=[
-        "numpy",
-        "pyaml",
-    ],
-    cmdclass={
-        "install": InstallWrapper,
-    },
-    zip_safe=True)
