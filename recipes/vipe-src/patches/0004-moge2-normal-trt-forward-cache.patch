+def recover_metric_depth(
+    forward: MoGe2Forward, *, fov_x: float | None, image_hw: tuple[int, int]
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """MoGe-2's post-processing of one forward: (depth (H,W), mask (H,W) bool, normalised K (3,3)).
+
+    ``fov_x=None`` recovers the focal as well (MoGe-2's free-FoV mode). The cached
+    forward is never modified.
+    """
+
+    from monopriors.third_party.moge.model._inference import recover_shift_and_intrinsics
+
+    points = forward.points[None].clone()
+    mask = forward.mask[None].clone()
+    camera = recover_shift_and_intrinsics(points, mask, fov_x=fov_x, aspect_ratio=points.shape[2] / points.shape[1])
+    depth = (points[..., 2] + camera.shift_b[:, None, None]) * forward.metric_scale
+    mask &= depth > 0
+    depth = F.interpolate(depth[:, None], size=image_hw, mode="bilinear", align_corners=False)[:, 0]
+    mask = F.interpolate(mask[:, None].float(), size=image_hw, mode="nearest")[:, 0] > 0.5
+    return depth[0], mask[0], camera.intrinsics_b33[0]
+
 
