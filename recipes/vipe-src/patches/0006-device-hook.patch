@@ -227,6 +227,52 @@ class CudaOps:
         return float(start.elapsed_time(end)) / 1000.0
 
 
+
+class _HostEvent:
+    """A timing event for a device without CUDA streams: the host clock after the device drains."""
+
+    def __init__(self, device: torch.device) -> None:
+        self.device = device
+        self.seconds = 0.0
+
+    def record(self, stream: Any = None) -> None:
+        if self.device.type == "mps":
+            torch.mps.synchronize()
+        self.seconds = time.perf_counter()
+
+    def elapsed_time(self, end: _HostEvent) -> float:
+        return (end.seconds - self.seconds) * 1000.0
+
+
+class _HostStream:
+    def wait_event(self, event: Any) -> None:
+        pass
+
+
+class HostOps(CudaOps):
+    """:class:`CudaOps` for MPS and CPU: one in-order queue, so stream waits are no-ops."""
+
+    def current_stream(self) -> Any:
+        return _HostStream()
+
+    def new_stream(self) -> Any:
+        return _HostStream()
+
+    def event(self) -> Any:
+        return _HostEvent(self.device)
+
+    @contextmanager
+    def producer_context(self, stream: Any) -> Iterator[None]:
+        with torch.inference_mode():
+            yield
+
+    def record_stream(self, tensor: torch.Tensor, stream: Any) -> None:
+        pass
+
+    def synchronize(self) -> None:
+        if self.device.type == "mps":
+            torch.mps.synchronize()
+
 _SENTINEL = object()
 
 PrepareFn = Callable[[int, Any, bool], PreparedFrame]
