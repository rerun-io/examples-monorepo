diff --git a/vipe/utils/device.py b/vipe/utils/device.py
new file mode 100644
index 0000000..3370223
--- /dev/null
+++ b/vipe/utils/device.py
@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: Apache-2.0
+"""The one device ViPE runs on: CUDA when present, else Apple MPS, else CPU.
+
+``VIPE_DEVICE`` (e.g. ``cpu``, ``mps``, ``cuda:1``) overrides the choice. The result is fixed
+for the process: module-level ``autocast`` decorators read it at import time.
+"""
+
+import functools
+import os
+
+import torch
+
+
+@functools.cache
+def device() -> torch.device:
+    override = os.environ.get("VIPE_DEVICE")
+    if override:
+        return torch.device(override)
+    if torch.cuda.is_available():
+        return torch.device("cuda")
+    if torch.backends.mps.is_available():
+        return torch.device("mps")
+    return torch.device("cpu")
