+template <typename T>
+__global__ void ScaleKernel(T* x, size_t n, T a) {
+  const size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x;
+  if (i < n) x[i] *= a;
+}
+
+template <typename T>
+void Scale(T* start, T* end, T a) {
+  const size_t n = end - start;
+  if (n > 0) ScaleKernel<T><<<(n + 255) / 256, 256>>>(start, n, a);
+}
+
+template <typename T>
+__global__ void SubtractKernel(const T* a, const T* b, T* out, size_t n) {
+  const size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x;
+  if (i < n) out[i] = a[i] - b[i];
+}
+
+template <typename T>
+void Subtract(const T* a_start, const T* a_end, const T* b, T* out) {
+  const size_t n = a_end - a_start;
+  if (n > 0) SubtractKernel<T><<<(n + 255) / 256, 256>>>(a_start, b, out, n);
+}
