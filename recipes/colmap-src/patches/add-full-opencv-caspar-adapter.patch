@@ -216,6 +216,37 @@ class ConstOpenCVFisheyeFocalAndExtra(sf.V6):
     pass
 
 
+# FullOpenCV: camera.params = [fx, fy, cx, cy, k1, k2, p1, p2, k3, k4, k5, k6]
+# (COLMAP's FullOpenCVCameraModel, sensor/models.h).  Twelve parameters: like
+# THIN_PRISM_FISHEYE (upstream PR #4657), a merged or split *tunable* calib of
+# this size does not fit the 48 KB shared-memory budget, so only the
+# fixed-calibration factors are generated, with the calib passed as constant
+# sequential data:
+#   focal_and_extra = [fx, fy, k1, k2, p1, p2, k3, k4, k5, k6]
+#   principal_point = [cx, cy]
+# That is the calibrated-rig case (fixed intrinsics, fixed sensor_from_rig,
+# variable points, fixed or variable rig poses), which is what a rig with an
+# 8-coefficient OpenCV calibration runs.
+class FullOpenCVPose(sf.Pose3):
+    pass
+
+
+class ConstFullOpenCVPose(sf.Pose3):
+    pass
+
+
+class ConstFullOpenCVSensorFromRig(sf.Pose3):
+    pass
+
+
+class ConstFullOpenCVPrincipalPoint(sf.V2):
+    pass  # [cx, cy]
+
+
+class ConstFullOpenCVFocalAndExtra(sf.Matrix(10, 1).__class__):
+    pass  # [fx, fy, k1, k2, p1, p2, k3, k4, k5, k6]
+
+
 # Constant sensor-from-rig calibration, stored as ConstantSequential
 # (7 floats = 28 B f32 / 56 B f64 loaded from global memory per factor).
 # ConstantShared would deduplicate to one slot per unique sensor per block,
@@ -503,6 +534,81 @@ def opencv_fisheye_split_core(
     return opencv_fisheye_core(pose, sensor_from_rig, calib, point, pixel)
 
 
+def full_opencv_project(point_cam, focal_and_extra, principal_point) -> sf.V2:
+    """COLMAP FULL_OPENCV projection (FullOpenCVCameraModel, sensor/models.h).
+
+    With (u, v) = (X/Z, Y/Z) and r2 = u^2 + v^2:
+
+        radial = (1 + k1 r2 + k2 r2^2 + k3 r2^3) / (1 + k4 r2 + k5 r2^2 + k6 r2^3)
+        x = u * radial + 2 p1 u v + p2 (r2 + 2 u^2)
+        y = v * radial + 2 p2 u v + p1 (r2 + 2 v^2)
+        (X, Y) = (fx x + cx, fy y + cy)
+
+    i.e. COLMAP's Distortion() adds (du, dv) = (x - u, y - v) to (u, v).
+    Bundle adjustment needs only this forward map, so the regions where the
+    rational model does not invert play no part.
+    """
+    fx, fy, k1, k2, p1, p2, k3, k4, k5, k6 = focal_and_extra
+    cx, cy = principal_point
+    depth = point_cam[2]
+    p = sf.V2(point_cam[:2]) / (depth + sf.epsilon() * sf.sign_no_zero(depth))
+    u, v = p[0], p[1]
+    u2 = u * u
+    uv = u * v
+    v2 = v * v
+    r2 = u2 + v2
+    r4 = r2 * r2
+    r6 = r4 * r2
+    radial = (1 + k1 * r2 + k2 * r4 + k3 * r6) / (1 + k4 * r2 + k5 * r4 + k6 * r6)
+    x = u * radial + 2 * p1 * uv + p2 * (r2 + 2 * u2)
+    y = v * radial + 2 * p2 * uv + p1 * (r2 + 2 * v2)
+    return sf.V2([fx * x + cx, fy * y + cy])
+
+
+def full_opencv_split_fixed_focal_and_extra_fixed_principal_point(
+    pose: T.Annotated[FullOpenCVPose, mem.TunableShared],
+    sensor_from_rig: T.Annotated[
+        ConstFullOpenCVSensorFromRig, mem.ConstantSequential
+    ],
+    focal_and_extra: T.Annotated[
+        ConstFullOpenCVFocalAndExtra, mem.ConstantSequential
+    ],
+    principal_point: T.Annotated[
+        ConstFullOpenCVPrincipalPoint, mem.ConstantSequential
+    ],
+    point: T.Annotated[Point, mem.TunableShared],
+    pixel: T.Annotated[ConstPixel, mem.ConstantSequential],
+) -> sf.V2:
+    """FULL_OPENCV fixed-calib pose+point BA residual."""
+    cam_T_world = sensor_from_rig * pose
+    return (
+        full_opencv_project(cam_T_world * point, focal_and_extra, principal_point)
+        - pixel
+    )
+
+
+def full_opencv_split_fixed_pose_fixed_focal_and_extra_fixed_principal_point(
+    point: T.Annotated[Point, mem.TunableShared],
+    sensor_from_rig: T.Annotated[
+        ConstFullOpenCVSensorFromRig, mem.ConstantSequential
+    ],
+    pose: T.Annotated[ConstFullOpenCVPose, mem.ConstantSequential],
+    focal_and_extra: T.Annotated[
+        ConstFullOpenCVFocalAndExtra, mem.ConstantSequential
+    ],
+    principal_point: T.Annotated[
+        ConstFullOpenCVPrincipalPoint, mem.ConstantSequential
+    ],
+    pixel: T.Annotated[ConstPixel, mem.ConstantSequential],
+) -> sf.V2:
+    """FULL_OPENCV fixed-pose/fixed-calib point BA residual."""
+    cam_T_world = sensor_from_rig * pose
+    return (
+        full_opencv_project(cam_T_world * point, focal_and_extra, principal_point)
+        - pixel
+    )
+
