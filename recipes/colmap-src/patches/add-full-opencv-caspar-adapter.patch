+// FullOpenCV implementation.
+//
+// FULL_OPENCV has twelve parameters, so (like THIN_PRISM_FISHEYE in upstream
+// PR #4657) only fixed-intrinsics, fixed-sensor rig factors are generated:
+// pose+point BA and points-only BA, with the calibration passed as constant
+// sequential data. Any other variant fails explicitly instead of silently
+// skipping observations.
+class FullOpenCVAdapter : public ICasparModelAdapter {
+ public:
+  CameraModelId ModelId() const override { return CameraModelId::kFullOpenCV; }
+
+  // COLMAP params: [fx, fy, cx, cy, k1, k2, p1, p2, k3, k4, k5, k6]
+  // CASPAR split constants:
+  //   focal_and_extra = [fx, fy, k1, k2, p1, p2, k3, k4, k5, k6]
+  //   principal_point = [cx, cy]
+  size_t FocalAndExtraSize() const override { return 10; }
+  size_t PrincipalPointSize() const override { return 2; }
+  size_t CalibSize() const override {
+    return FocalAndExtraSize() + PrincipalPointSize();
+  }
+
+  void FillSizing(CasparSolverSizing& sz,
+                  const ModelData& md,
+                  size_t) const override {
+    for (int v = 0; v < CASPAR_NUM_VARIANTS; ++v) {
+      const size_t n = md.variants[v].num_factors;
+      if (n == 0) {
+        continue;
+      }
+      switch (static_cast<FactorVariant>(v)) {
+        case FactorVariant::FIXED_FOCAL_AND_EXTRA_FIXED_PRINCIPAL_POINT:
+          sz.num_full_opencv_split_fixed_focal_and_extra_fixed_principal_point =
+              n;
+          break;
+        case FactorVariant::
+            FIXED_POSE_FIXED_FOCAL_AND_EXTRA_FIXED_PRINCIPAL_POINT:
+          sz.num_full_opencv_split_fixed_pose_fixed_focal_and_extra_fixed_principal_point =
+              n;
+          break;
+        default:
+          UnsupportedVariant();
+      }
+    }
+  }
+
+  void ExtractFocalAndExtra(const Camera& camera,
+                            std::vector<StorageType>& out) const override {
+    out.push_back(static_cast<StorageType>(camera.params[0]));   // fx
+    out.push_back(static_cast<StorageType>(camera.params[1]));   // fy
+    out.push_back(static_cast<StorageType>(camera.params[4]));   // k1
+    out.push_back(static_cast<StorageType>(camera.params[5]));   // k2
+    out.push_back(static_cast<StorageType>(camera.params[6]));   // p1
+    out.push_back(static_cast<StorageType>(camera.params[7]));   // p2
+    out.push_back(static_cast<StorageType>(camera.params[8]));   // k3
+    out.push_back(static_cast<StorageType>(camera.params[9]));   // k4
+    out.push_back(static_cast<StorageType>(camera.params[10]));  // k5
+    out.push_back(static_cast<StorageType>(camera.params[11]));  // k6
+  }
+
+  void ExtractPrincipalPoint(const Camera& camera,
+                             std::vector<StorageType>& out) const override {
+    out.push_back(static_cast<StorageType>(camera.params[2]));  // cx
+    out.push_back(static_cast<StorageType>(camera.params[3]));  // cy
+  }
+
+  void WriteFocalAndExtra(Camera&, const StorageType*, size_t) const override {
+    UnsupportedIntrinsicsWrite();
+  }
+
+  void WritePrincipalPoint(Camera&, const StorageType*, size_t) const override {
+    UnsupportedIntrinsicsWrite();
+  }
+
+  void SetPoseNodes(caspar::GraphSolver& s,
+                    StorageType* data,
+                    size_t n) const override {
+    s.SetFullOpenCVPoseNodesFromStackedHost(data, 0, n);
+  }
+  void GetPoseNodes(caspar::GraphSolver& s,
+                    StorageType* data,
+                    size_t n) const override {
+    s.GetFullOpenCVPoseNodesToStackedHost(data, 0, n);
+  }
+  void SetFocalAndExtraNodes(caspar::GraphSolver&,
+                             StorageType*,
+                             size_t) const override {}
+  void GetFocalAndExtraNodes(caspar::GraphSolver&,
+                             StorageType*,
+                             size_t) const override {}
+  void SetPrincipalPointNodes(caspar::GraphSolver&,
+                              StorageType*,
+                              size_t) const override {}
+  void GetPrincipalPointNodes(caspar::GraphSolver&,
+                              StorageType*,
+                              size_t) const override {}
+  void SetCalibNodes(caspar::GraphSolver&, StorageType*, size_t) const override {
+  }
+  void GetCalibNodes(caspar::GraphSolver&, StorageType*, size_t) const override {
+  }
+
+  void SetVariantFactors(caspar::GraphSolver& s,
+                         FactorVariant variant,
+                         const VariantData& d) const override {
+    const size_t n = d.num_factors;
+    switch (variant) {
+      case FactorVariant::FIXED_FOCAL_AND_EXTRA_FIXED_PRINCIPAL_POINT:
+        s.SetFullOpencvSplitFixedFocalAndExtraFixedPrincipalPointNum(n);
+        s.SetFullOpencvSplitFixedFocalAndExtraFixedPrincipalPointPoseIndicesFromHost(
+            d.pose_indices.data(), n);
+        s.SetFullOpencvSplitFixedFocalAndExtraFixedPrincipalPointPointIndicesFromHost(
+            d.point_indices.data(), n);
+        s.SetFullOpencvSplitFixedFocalAndExtraFixedPrincipalPointSensorFromRigDataFromStackedHost(
+            d.sensor_from_rig_data.data(), 0, n);
+        s.SetFullOpencvSplitFixedFocalAndExtraFixedPrincipalPointFocalAndExtraDataFromStackedHost(
+            d.const_focal_and_extra.data(), 0, n);
+        s.SetFullOpencvSplitFixedFocalAndExtraFixedPrincipalPointPrincipalPointDataFromStackedHost(
+            d.const_principal_point.data(), 0, n);
+        s.SetFullOpencvSplitFixedFocalAndExtraFixedPrincipalPointPixelDataFromStackedHost(
+            d.pixels.data(), 0, n);
+        break;
+      case FactorVariant::
+          FIXED_POSE_FIXED_FOCAL_AND_EXTRA_FIXED_PRINCIPAL_POINT:
+        s.SetFullOpencvSplitFixedPoseFixedFocalAndExtraFixedPrincipalPointNum(n);
+        s.SetFullOpencvSplitFixedPoseFixedFocalAndExtraFixedPrincipalPointPointIndicesFromHost(
+            d.point_indices.data(), n);
+        s.SetFullOpencvSplitFixedPoseFixedFocalAndExtraFixedPrincipalPointSensorFromRigDataFromStackedHost(
+            d.sensor_from_rig_data.data(), 0, n);
+        s.SetFullOpencvSplitFixedPoseFixedFocalAndExtraFixedPrincipalPointPoseDataFromStackedHost(
+            d.const_poses.data(), 0, n);
+        s.SetFullOpencvSplitFixedPoseFixedFocalAndExtraFixedPrincipalPointFocalAndExtraDataFromStackedHost(
+            d.const_focal_and_extra.data(), 0, n);
+        s.SetFullOpencvSplitFixedPoseFixedFocalAndExtraFixedPrincipalPointPrincipalPointDataFromStackedHost(
+            d.const_principal_point.data(), 0, n);
+        s.SetFullOpencvSplitFixedPoseFixedFocalAndExtraFixedPrincipalPointPixelDataFromStackedHost(
+            d.pixels.data(), 0, n);
+        break;
+      default:
+        UnsupportedVariant();
+    }
+  }
+
+ private:
+  static void UnsupportedVariant() {
+    LOG(FATAL_THROW)
+        << "FULL_OPENCV is supported by CASPAR only for fixed intrinsics and "
+           "fixed sensor_from_rig, with variable points3D and fixed or "
+           "variable rig_from_world poses.";
+  }
+  static void UnsupportedIntrinsicsWrite() {
+    LOG(FATAL_THROW) << "Writing FULL_OPENCV intrinsics from CASPAR is "
+                        "unsupported; run with fixed intrinsics.";
+  }
+};
