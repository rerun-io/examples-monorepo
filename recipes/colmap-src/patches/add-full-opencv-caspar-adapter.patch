diff --git a/src/thirdparty/Symforce-Caspar/caspar_generate.py b/src/thirdparty/Symforce-Caspar/caspar_generate.py
index 06fb06f987482cc777273d076ff1ad44003b2033..a1719558a9a033e2889909d11be756a5d35d3365 100644
