diff -ru a/src/pycolmap/scene/database.cc b/src/pycolmap/scene/database.cc
--- a/src/pycolmap/scene/database.cc	2026-11-16 22:00:47.261557532 -0600
+++ b/src/pycolmap/scene/database.cc	2026-11-16 22:01:07.463655826 -0600
@@ -23,7 +23,14 @@
     transaction_ = std::make_unique<DatabaseTransaction>(database_);
   }
 
-  void Exit(const py::args&) { transaction_.reset(); }
+  // An exception leaving the `with` block rolls the transaction back; a normal
+  // exit commits it.
+  void Exit(const py::args& args) {
+    if (transaction_ && !args.empty() && !args[0].is_none()) {
+      transaction_->Rollback();
+    }
+    transaction_.reset();
+  }
 
  private:
   Database* database_;
