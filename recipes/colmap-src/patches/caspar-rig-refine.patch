+  static RigCalibState GetRigCalibState(const Camera& camera,
+                                        bool focal_and_extra,
+                                        bool principal_point_var,
+                                        const ICasparModelAdapter& adapter) {
+    RigCalibState state = RigCalibState::FIXED;
+    if (focal_and_extra && principal_point_var) {
+      state = RigCalibState::MERGED;
+    } else if (focal_and_extra) {
+      state = RigCalibState::FOCAL_AND_EXTRA;
+    } else if (principal_point_var) {
+      LOG(FATAL_THROW) << "Camera " << camera.camera_id
+                       << ": refine_sensor_from_rig with only the principal "
+                          "point refined is not supported by CASPAR. Use the "
+                          "Ceres BA.";
+    }
+    if (!adapter.SupportsRigCalibState(state)) {
+      LOG(FATAL_THROW) << "Camera " << camera.camera_id << " ("
+                       << camera.ModelName()
+                       << "): refine_sensor_from_rig with refined intrinsics "
+                          "is not supported by CASPAR for this model. Fix "
+                          "the intrinsics or use the Ceres BA.";
+    }
+    return state;
+  }
+
+  // One SensorFromRig node per (rig, non-reference sensor), per model.
+  size_t GetOrCreateSensorFromRig(const Image& image,
+                                  const CameraModelId model_id) {
+    const Frame& frame = *image.FramePtr();
+    const std::pair<rig_t, sensor_t> key(frame.RigId(),
+                                         image.DataId().sensor_id);
+    auto& index = sensor_from_rig_index_per_model_[model_id];
+    const size_t next = index.size();
+    auto [it, inserted] = index.try_emplace(key, next);
+    if (inserted) {
+      sensor_from_rig_keys_per_model_[model_id].push_back(key);
+      Rigid3d sensor_from_rig = frame.RigPtr()->SensorFromRig(key.second);
+      sensor_from_rig.rotation().normalize();
+      AppendPose(sensor_from_rig_data_per_model_[model_id], sensor_from_rig);
+    }
+    return it->second;
+  }
