+    """Register the factors with a tunable sensor_from_rig.
+
+    Every combination of {pose, point} fixed/tunable is registered for each
+    calibration state in `calib_fixed_sets` (the calib parameters held
+    constant: () for a tunable merged calib, ("principal_point",) for focal and
+    extra only, both split groups for a calibrated camera).  Names follow
+    register_camera_model with "_rig" after the model name, e.g.
+    `opencv_fisheye_rig_split_fixed_pose_fixed_principal_point`.
+    """
+    hints = get_type_hints(core_fn, include_extras=True)
+    base_params = list(inspect.signature(core_fn).parameters.keys())
+    overrides = {
+        "sensor_from_rig": Annotated[sensor_from_rig_type, mem.TunableShared]
+    }
+    fixable_items = list(fixable_params.items())
+    for calib_fixed in calib_fixed_sets:
+        for fix_pose in (False, True):
+            for fix_point in (False, True):
+                fixed_names = set(calib_fixed)
+                if fix_pose:
+                    fixed_names.add("pose")
+                if fix_point:
+                    fixed_names.add("point")
+                fixed = {p: t for p, t in fixable_items if p in fixed_names}
+                suffix = "_".join(
+                    f"fixed_{p}" for p, _ in fixable_items if p in fixed
+                )
+                name = f"{model_name}_{suffix}" if suffix else model_name
+                caslib.add_factor(
+                    _make_variant(
+                        core_fn, name, base_params, hints, fixed, overrides
