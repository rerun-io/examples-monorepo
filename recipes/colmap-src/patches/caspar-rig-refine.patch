+# ---------------------------------------------------------------------------
+# Generator change: no shared `_local` buffer for the residual sum of factors
+# with four tunable nodes.
+#
+# A factor kernel's static shared memory is its largest accessor buffer
+# (`inout_shared`, 16 KB at 1024 threads) plus one SharedIndex array per
+# tunable node (8 B x 1024 = 8 KB each) plus, for `AddSum` outputs, a
+# `__shared__ float <name>_local[dim]` that only carries the block's sum from
+# `SumStore` to `SumFlushFinal`.  With four tunable nodes (pose,
+# sensor_from_rig, calib, point: the rig factors that refine intrinsics) the
+# score and res_jac_first kernels need 16 KB + 32 KB + 4 B, 4 bytes over the
+# 48 KB static limit.  The block size cannot simply shrink: SharedIndices
+# groups the indices of every factor in 1024-thread blocks.
+#
+# For those factors only, `AddSumDirect` reduces exactly as `SumStore` does
+# (warp sums into `inout_shared`, then warp 0) and has thread 0 add the block
+# total to global memory itself, the one atomicAdd per block that
+# `SumFlushFinal` did, so the `_local` buffer goes.  Every other kernel is
+# generated as before.
+class AddSumDirect(mem.AddSum):
+    """`AddSum` whose block total goes straight to global memory."""
+
+    def write_template(self, idx: int) -> str:
+        common: Common = Common(self, idx)
+        if common.dim != 1:
+            raise NotImplementedError("AddSumDirect sums scalars only")
+        t = common.storage_t
+        return f"""
+    }}}};
+    {{{{
+      auto group = cg::tiled_partition<32>(cg::this_thread_block());
+      __syncthreads();
+      {t} tot = cg::reduce(group, global_thread_idx < problem_size ? {{arg_0}} : static_cast<{t}>(0), cg::plus<{t}>());
+      if (group.thread_rank() == 0) {{{{
+        (({common.SharedT}*)inout_shared)[group.meta_group_rank()] = tot;
+      }}}}
+      __syncthreads();
+      if (group.meta_group_rank() == 0) {{{{
+        tot = cg::reduce(group, (({common.SharedT}*)inout_shared)[group.thread_rank()], cg::plus<{t}>());
+        if (group.thread_rank() == 0) {{{{
+          atomicAdd(&{self.name}[{self.chunk_indices[idx][0]}], tot);
+        }}}}
+      }}}}
+    }}}}
+    if (global_thread_idx < problem_size) {{{{
+    """.strip()
+
+    def pre_calc_code(self) -> str:  # noqa: PLR6301
+        return ""
+
+    def post_calc_code(self) -> str:  # noqa: PLR6301
+        return ""
+
+
+_FOUR_TUNABLE_NODES = 4
+_factor_make_kernels = _factor_module.Factor.make_kernels
+
+
+def _make_kernels_shared_budget(self: Any) -> Any:
+    """Build a factor's kernels, with AddSumDirect for four tunable nodes."""
+    if len(self.node_arg_types) < _FOUR_TUNABLE_NODES:
+        return _factor_make_kernels(self)
+    _factor_module.AddSum = AddSumDirect
+    try:
+        return _factor_make_kernels(self)
+    finally:
+        _factor_module.AddSum = mem.AddSum
+
+
+_factor_module.Factor.make_kernels = _make_kernels_shared_budget
+
