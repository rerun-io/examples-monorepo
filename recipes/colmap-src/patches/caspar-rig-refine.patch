+// Rig factors (tunable sensor_from_rig, refine_sensor_from_rig=true):
+// index = 4 * calib state + 2 * (pose fixed) + (point fixed), with calib state
+// 0 = merged calib tunable, 1 = focal and extra tunable (principal point
+// fixed), 2 = calibration fixed. The order is the registration order in
+// Symforce-Caspar/caspar_generate.py (register_rig_variants).
+#define CASPAR_NUM_RIG_VARIANTS 12
+enum class RigCalibState { MERGED = 0, FOCAL_AND_EXTRA = 1, FIXED = 2 };
+inline int RigVariantIndex(RigCalibState calib, bool pose_var, bool point_var) {
+  return 4 * static_cast<int>(calib) + (pose_var ? 0 : 2) +
+         (point_var ? 0 : 1);
+}
+
 struct VariantData {
   std::vector<unsigned int> pose_indices;
+  std::vector<unsigned int> sensor_from_rig_indices;  // rig factors only
   std::vector<StorageType> sensor_from_rig_data;  // 7 floats per factor
